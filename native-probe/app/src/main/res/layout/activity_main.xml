<?xml version="1.0" encoding="utf-8"?>
<!-- Экран повторяет Flutter-версию: шапка с названием и вкладками, фоновая
     картинка под тему, а на главной вкладке — пилюля температуры и две
     зеркальные половины салона, разделённые полосой.

     Размеры в dp совпадают с логическими пикселями Flutter, поэтому пропорции
     переносятся один в один: сиденье 300, разделитель 400x2, отступ между
     переключателями 60. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/system_black">

    <LinearLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_height="wrap_content"
        android:paddingStart="32dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Подогрев сидений"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/system_white" />

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:layout_marginStart="33dp"
            android:layout_marginEnd="33dp"
            android:background="@color/system_white" />

        <TextView
            android:id="@+id/tabHeat"
            style="@style/TabButton"
            android:text="Управление" />

        <TextView
            android:id="@+id/tabPresets"
            style="@style/TabButton"
            android:text="Пресеты" />

        <TextView
            android:id="@+id/tabSettings"
            style="@style/TabButton"
            android:text="Настройки" />

        <!-- Вкладка логов появляется по долгому нажатию на температуру, как
             debug-режим во Flutter-версии. -->
        <TextView
            android:id="@+id/tabLog"
            style="@style/TabButton"
            android:text="Логи"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ViewFlipper
            android:id="@+id/flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="32dp"
            android:paddingTop="49dp"
            android:paddingEnd="32dp"
            android:paddingBottom="32dp">

            <!-- ================= Управление ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Долгое нажатие включает вкладку логов -->
                <LinearLayout
                    android:id="@+id/temperaturePill"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/pill_temperature">

                    <ImageView
                        android:id="@+id/temperatureIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Температура в салоне"
                        android:src="@drawable/ic_thermostat" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Температура в салоне: "
                        android:textSize="16sp"
                        android:textColor="@color/text_body" />

                    <TextView
                        android:id="@+id/temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- °C"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/temp_warm" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="340dp"
                    android:layout_marginTop="25dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Водитель: управление слева, сиденье справа -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <LinearLayout
                                android:id="@+id/driverModes"
                                android:layout_width="452dp"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />

                            <LinearLayout
                                android:id="@+id/driverLevels"
                                android:layout_width="220dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="68dp"
                                android:orientation="horizontal" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/driverSeat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <ImageView
                                android:id="@+id/driverSeatImage"
                                android:layout_width="300dp"
                                android:layout_height="300dp"
                                android:contentDescription="Сиденье водителя"
                                android:src="@drawable/seat" />

                            <LinearLayout
                                android:id="@+id/driverDots"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:orientation="horizontal" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="400dp"
                        android:id="@+id/centerDivider" />

                    <!-- Пассажир: зеркально — сиденье слева, управление справа -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <LinearLayout
                            android:id="@+id/passengerSeat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="24dp"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <ImageView
                                android:id="@+id/passengerSeatImage"
                                android:layout_width="300dp"
                                android:layout_height="300dp"
                                android:contentDescription="Сиденье пассажира"
                                android:src="@drawable/seat" />

                            <LinearLayout
                                android:id="@+id/passengerDots"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:orientation="horizontal" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <LinearLayout
                                android:id="@+id/passengerModes"
                                android:layout_width="452dp"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />

                            <LinearLayout
                                android:id="@+id/passengerLevels"
                                android:layout_width="220dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="68dp"
                                android:orientation="horizontal" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ================= Пресеты =================
                 Раскладка оригинала: сверху по центру выбор сиденья, слева
                 редактор со слайдерами, справа список сохранённых. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/presetSeatSegments"
                    android:layout_width="276dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="30dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="32dp">

                        <TextView
                            android:id="@+id/presetEditorTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Создайте новый пресет"
                            android:textSize="24sp"
                            android:textColor="@color/text_body" />

                        <LinearLayout
                            android:id="@+id/presetLevels"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/presetThresholdTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="28dp"
                            android:textSize="16sp"
                            android:textColor="@color/text_body" />

                        <SeekBar
                            android:id="@+id/presetThreshold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:max="4" />

                        <LinearLayout
                            android:id="@+id/presetThresholdLabels"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                        <TextView
                            android:id="@+id/presetSave"
                            style="@style/PrimaryButton"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="28dp"
                            android:text="Сохранить" />
                    </LinearLayout>

                    <View
                        android:id="@+id/presetDivider"
                        android:layout_width="2dp"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="32dp">

                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1">

                            <LinearLayout
                                android:id="@+id/presetList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </ScrollView>

                        <TextView
                            android:id="@+id/presetNew"
                            style="@style/PrimaryButton"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="16dp"
                            android:text="Новый пресет" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ================= Настройки ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Тема приложения:"
                        android:textSize="24sp"
                        android:textColor="@color/text_body" />

                    <LinearLayout
                        android:id="@+id/themeSegments"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Показывать температуру в салоне:"
                        android:textSize="24sp"
                        android:textColor="@color/text_body" />

                    <Switch
                        android:id="@+id/showTemperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Разрешения: в оригинале строки нет — там службу доступности
                     включали вслепую через настройки головы. Здесь видно, выданы
                     ли права, и кнопка ведёт прямо на нужный экран. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Необходимые разрешения:"
                        android:textSize="24sp"
                        android:textColor="@color/text_body" />

                    <ImageView
                        android:id="@+id/permissionsGranted"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="Разрешения выданы"
                        android:src="@drawable/ic_check"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/enableAutostart"
                        style="@style/PrimaryButton"
                        android:text="Получить" />
                </LinearLayout>

                <TextView
                    android:id="@+id/startCascade"
                    style="@style/PrimaryButton"
                    android:layout_gravity="end"
                    android:layout_marginTop="24dp"
                    android:text="Запустить каскад сейчас" />
            </LinearLayout>

            <!-- ================= Логи =================
                 Порт LogsScreen: слева живой лог, справа инжектор температуры.
                 Экран — единственный вывод диагностики, adb к голове нет. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/logCounter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 / 500"
                            android:textSize="15sp"
                            android:textColor="@color/text_body" />

                        <CheckBox
                            android:id="@+id/autoScroll"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="24dp"
                            android:checked="true"
                            android:text="Автопрокрутка"
                            android:textSize="15sp"
                            android:textColor="@color/text_body" />

                        <TextView
                            android:id="@+id/readTemp"
                            style="@style/PrimaryButton"
                            android:text="Прочитать" />

                        <TextView
                            android:id="@+id/restartCar"
                            style="@style/PrimaryButton"
                            android:layout_marginStart="12dp"
                            android:text="Переподключиться" />

                        <TextView
                            android:id="@+id/copyLog"
                            style="@style/PrimaryButton"
                            android:layout_marginStart="12dp"
                            android:text="Скопировать" />

                        <TextView
                            android:id="@+id/clearLog"
                            style="@style/PrimaryButton"
                            android:layout_marginStart="12dp"
                            android:text="Очистить" />
                    </LinearLayout>

                    <ScrollView
                        android:id="@+id/logScroll"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="12dp"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/log"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:typeface="monospace"
                            android:textColor="#8BC34A" />
                    </ScrollView>
                </LinearLayout>

                <!-- Сайдбар в прокрутке: на голове экран ниже эмулятора, и
                     нижние кнопки иначе оказываются за краем. -->
                <ScrollView
                    android:layout_width="320dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="24dp">

                <LinearLayout
                    android:id="@+id/injectPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Подстановка температуры"
                        android:textSize="20sp"
                        android:textColor="@color/text_body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Тот же путь, что и у события датчика."
                        android:textSize="13sp"
                        android:textColor="@color/text_muted" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/injectThermometer"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Текущая температура"
                            android:src="@drawable/ic_thermostat" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Сейчас в салоне"
                            android:textSize="14sp"
                            android:textColor="@color/text_body" />

                        <TextView
                            android:id="@+id/injectCurrent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- °C"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/temp_warm" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Быстрые значения"
                        android:textSize="14sp"
                        android:textColor="@color/text_body" />

                    <LinearLayout
                        android:id="@+id/quickTemperatures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Произвольное значение"
                        android:textSize="14sp"
                        android:textColor="@color/text_body" />

                    <EditText
                        android:id="@+id/injectValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="Например, -2.5"
                        android:inputType="numberSigned|numberDecimal"
                        android:maxLength="6"
                        android:textColor="@color/system_white"
                        android:textColorHint="@color/text_muted"
                        android:importantForAutofill="no" />

                    <TextView
                        android:id="@+id/injectTemp"
                        style="@style/PrimaryButton"
                        android:layout_gravity="end"
                        android:layout_marginTop="12dp"
                        android:text="Применить" />

                </LinearLayout>
                </ScrollView>
            </LinearLayout>

        </ViewFlipper>
    </FrameLayout>
</LinearLayout>
