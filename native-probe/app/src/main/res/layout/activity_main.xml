<?xml version="1.0" encoding="utf-8"?>
<!-- Разметка под альбомный экран головы (1920x720): слева управление,
     справа лог. Лог на экране обязателен — adb-доступа к голове нет. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#101418"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Подключение к Car…"
            android:textSize="20sp"
            android:textColor="#FFC107" />

        <TextView
            android:id="@+id/temperature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="— °C"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Водитель"
            android:textSize="18sp"
            android:textColor="#B0BEC5" />

        <LinearLayout
            android:id="@+id/driverRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Пассажир"
            android:textSize="18sp"
            android:textColor="#B0BEC5" />

        <LinearLayout
            android:id="@+id/passengerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/readTemp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Прочитать температуру" />

            <Button
                android:id="@+id/copyLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Копировать лог" />
        </LinearLayout>

        <!-- Проверка пересоединения без перезапуска CarService: настоящий
             onServiceDisconnected так не вызвать, но весь наш код разрыва и
             повторной подписки проходится целиком. -->
        <Button
            android:id="@+id/restartCar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Переподключиться к Car" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:background="#0A0D10"
        android:padding="8dp">

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:typeface="monospace"
            android:textColor="#8BC34A" />
    </ScrollView>
</LinearLayout>
