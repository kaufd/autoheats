<?xml version="1.0" encoding="utf-8"?>
<!-- Экран повторяет Flutter-версию: шапка с названием и вкладками, фоновая
     картинка под тему, а на главной вкладке — пилюля температуры и две
     зеркальные половины салона, разделённые полосой.

     Размеры в dp совпадают с логическими пикселями Flutter, поэтому пропорции
     переносятся один в один: сиденье 300, разделитель 400x2, отступ между
     переключателями 60. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/system_black">

    <LinearLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="32dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Подогрев сидений"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/system_white" />

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@color/system_white" />

        <TextView
            android:id="@+id/tabHeat"
            style="@style/TabButton"
            android:text="Управление" />

        <TextView
            android:id="@+id/tabPresets"
            style="@style/TabButton"
            android:text="Пресеты" />

        <TextView
            android:id="@+id/tabSettings"
            style="@style/TabButton"
            android:text="Настройки" />

        <!-- Вкладка логов появляется по долгому нажатию на температуру, как
             debug-режим во Flutter-версии. -->
        <TextView
            android:id="@+id/tabLog"
            style="@style/TabButton"
            android:text="Логи"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ViewFlipper
            android:id="@+id/flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="32dp"
            android:paddingTop="24dp"
            android:paddingEnd="32dp"
            android:paddingBottom="24dp">

            <!-- ================= Управление ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Долгое нажатие включает вкладку логов -->
                <LinearLayout
                    android:id="@+id/temperaturePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/pill_temperature"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:id="@+id/temperatureIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Температура в салоне"
                        android:src="@drawable/ic_thermostat" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Температура в салоне: "
                        android:textSize="17sp"
                        android:textColor="@color/text_body" />

                    <TextView
                        android:id="@+id/temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- °C"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/temp_warm" />
                </LinearLayout>

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_horizontal"
                    android:text="Подключение к автомобилю…"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Водитель: управление слева, сиденье справа -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <LinearLayout
                                android:id="@+id/driverModes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />

                            <LinearLayout
                                android:id="@+id/driverLevels"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="60dp"
                                android:orientation="horizontal" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/driverSeat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <ImageView
                                android:id="@+id/driverSeatImage"
                                android:layout_width="300dp"
                                android:layout_height="300dp"
                                android:contentDescription="Сиденье водителя"
                                android:src="@drawable/seat" />

                            <LinearLayout
                                android:id="@+id/driverDots"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:orientation="horizontal" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="400dp"
                        android:id="@+id/centerDivider" />

                    <!-- Пассажир: зеркально — сиденье слева, управление справа -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <LinearLayout
                            android:id="@+id/passengerSeat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="24dp"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <ImageView
                                android:id="@+id/passengerSeatImage"
                                android:layout_width="300dp"
                                android:layout_height="300dp"
                                android:contentDescription="Сиденье пассажира"
                                android:src="@drawable/seat" />

                            <LinearLayout
                                android:id="@+id/passengerDots"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:orientation="horizontal" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <LinearLayout
                                android:id="@+id/passengerModes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />

                            <LinearLayout
                                android:id="@+id/passengerLevels"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="60dp"
                                android:orientation="horizontal" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ================= Пресеты ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ScrollView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/presetList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <ScrollView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Новый пресет"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_body" />

                        <EditText
                            android:id="@+id/presetName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="Название"
                            android:inputType="text"
                            android:maxLength="40"
                            android:textColor="@color/system_white"
                            android:textColorHint="@color/text_muted"
                            android:importantForAutofill="no" />

                        <LinearLayout
                            android:id="@+id/presetSeatSegments"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Минут на уровнях 3 / 2 / 1"
                            android:textSize="14sp"
                            android:textColor="@color/text_muted" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/presetLevel3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="3"
                                android:inputType="number"
                                android:maxLength="2"
                                android:textColor="@color/system_white"
                                android:textColorHint="@color/text_muted"
                                android:importantForAutofill="no" />

                            <EditText
                                android:id="@+id/presetLevel2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:hint="2"
                                android:inputType="number"
                                android:maxLength="2"
                                android:textColor="@color/system_white"
                                android:textColorHint="@color/text_muted"
                                android:importantForAutofill="no" />

                            <EditText
                                android:id="@+id/presetLevel1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:hint="1"
                                android:inputType="number"
                                android:maxLength="2"
                                android:textColor="@color/system_white"
                                android:textColorHint="@color/text_muted"
                                android:importantForAutofill="no" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Не запускать, если в салоне теплее, °C"
                            android:textSize="14sp"
                            android:textColor="@color/text_muted" />

                        <EditText
                            android:id="@+id/presetThreshold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="5"
                            android:inputType="numberSigned|numberDecimal"
                            android:maxLength="5"
                            android:textColor="@color/system_white"
                            android:textColorHint="@color/text_muted"
                            android:importantForAutofill="no" />

                        <TextView
                            android:id="@+id/presetSave"
                            style="@style/PrimaryButton"
                            android:layout_marginTop="16dp"
                            android:text="Сохранить пресет" />
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <!-- ================= Настройки ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Оформление"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_body" />

                    <LinearLayout
                        android:id="@+id/themeSegments"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Показывать температуру в салоне"
                            android:textSize="16sp"
                            android:textColor="@color/text_body" />

                        <Switch
                            android:id="@+id/showTemperature"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="24dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Автозапуск после сна головы"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_body" />

                    <TextView
                        android:id="@+id/autostart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/enableAutostart"
                        style="@style/PrimaryButton"
                        android:layout_marginTop="12dp"
                        android:text="Включить автозапуск" />

                    <TextView
                        android:id="@+id/startCascade"
                        style="@style/PrimaryButton"
                        android:layout_marginTop="12dp"
                        android:text="Запустить каскад сейчас" />
                </LinearLayout>
            </LinearLayout>

            <!-- ================= Логи ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ScrollView
                    android:id="@+id/logScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#B3000000"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:typeface="monospace"
                        android:textColor="#8BC34A" />
                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/injectValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Температура, °C"
                        android:inputType="numberSigned|numberDecimal"
                        android:maxLength="6"
                        android:textColor="@color/system_white"
                        android:textColorHint="@color/text_muted"
                        android:importantForAutofill="no" />

                    <TextView
                        android:id="@+id/injectTemp"
                        style="@style/PrimaryButton"
                        android:layout_marginStart="8dp"
                        android:text="Подставить" />

                    <TextView
                        android:id="@+id/readTemp"
                        style="@style/PrimaryButton"
                        android:layout_marginStart="8dp"
                        android:text="Прочитать" />

                    <TextView
                        android:id="@+id/copyLog"
                        style="@style/PrimaryButton"
                        android:layout_marginStart="8dp"
                        android:text="Копировать" />

                    <TextView
                        android:id="@+id/restartCar"
                        style="@style/PrimaryButton"
                        android:layout_marginStart="8dp"
                        android:text="Переподключиться" />
                </LinearLayout>
            </LinearLayout>
        </ViewFlipper>
    </FrameLayout>
</LinearLayout>
