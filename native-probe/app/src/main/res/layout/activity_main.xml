<?xml version="1.0" encoding="utf-8"?>
<!-- Экран повторяет Flutter-версию: шапка с названием и вкладками, фоновая
     картинка под тему, а на главной вкладке — пилюля температуры и две
     зеркальные половины салона, разделённые полосой.

     Размеры в dp совпадают с логическими пикселями Flutter, поэтому пропорции
     переносятся один в один: сиденье 300, разделитель 400x2, отступ между
     переключателями 60. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/system_black">

    <LinearLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_height="wrap_content"
        android:paddingStart="32dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Подогрев сидений"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/system_white" />

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:layout_marginStart="33dp"
            android:layout_marginEnd="33dp"
            android:background="@color/system_white" />

        <TextView
            android:id="@+id/tabHeat"
            style="@style/TabButton"
            android:text="Управление" />

        <TextView
            android:id="@+id/tabPresets"
            style="@style/TabButton"
            android:text="Пресеты" />

        <TextView
            android:id="@+id/tabSettings"
            style="@style/TabButton"
            android:text="Настройки" />

        <!-- Вкладка логов появляется по долгому нажатию на температуру, как
             debug-режим во Flutter-версии. -->
        <TextView
            android:id="@+id/tabLog"
            style="@style/TabButton"
            android:text="Логи"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Вкладки листаются пальцем, как TabBarView во Flutter-версии.
             Страницы лежат прямо здесь, а не создаются адаптером: контроллеры
             вкладок ищут свои View через activity.findViewById, и страница,
             вынутая из дерева, стала бы для них невидимой. -->
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="32dp"
            android:paddingTop="49dp"
            android:paddingEnd="32dp"
            android:paddingBottom="32dp">

            <include layout="@layout/tab_heat" />
            <include layout="@layout/tab_presets" />
            <include layout="@layout/tab_settings" />
            <include layout="@layout/tab_logs" />

        </androidx.viewpager.widget.ViewPager>
    </FrameLayout>
</LinearLayout>
