<?xml version="1.0" encoding="utf-8"?>
<!-- Кнопки Flutter-версии: скруглённые «пилюли» с заливкой акцентом, а не
     системные Material-кнопки. Поэтому обычные TextView со своим фоном —
     он же красится под выбранную тему. -->
<resources>
    <style name="TabButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textColor">@color/system_white</item>
        <item name="android:background">@drawable/tab_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="PrimaryButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/system_white</item>
        <item name="android:background">@drawable/tab_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
