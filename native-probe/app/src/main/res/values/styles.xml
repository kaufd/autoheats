<?xml version="1.0" encoding="utf-8"?>
<!-- Кнопки Flutter-версии: скруглённые «пилюли» с заливкой акцентом, а не
     системные Material-кнопки. Поэтому обычные TextView со своим фоном —
     он же красится под выбранную тему. -->
<resources>
    <style name="TabButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">43dp</item>
        <item name="android:paddingEnd">43dp</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textColor">@color/system_white</item>
        <item name="android:background">@drawable/tab_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="PrimaryButton">
        <!-- По этому тегу Ui.paintButtons находит кнопки обходом дерева. Так
             новая кнопка перекрашивается при смене темы сама, а не после того,
             как о ней вспомнят в MainActivity. -->
        <item name="android:tag">accentButton</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/system_white</item>
        <item name="android:background">@drawable/tab_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Кнопка без заливки: прозрачный фон, обводка акцентом, белый текст.
         Так выглядят невыбранные кнопки тем и «Отмена» в диалогах — вариант
         для действий, которые не должны спорить за внимание с основными. -->
    <style name="SecondaryButton" parent="PrimaryButton">
        <item name="android:tag">outlineButton</item>
    </style>
</resources>
