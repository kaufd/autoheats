<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permission envelope зеркалит рабочее приложение (см. CLAUDE.md: набор
         не тримить без smoke-теста на голове). Из него не взято только то,
         чего в пробнике нет физически: будильники, вибрация, wake lock,
         accessibility. Сверено: у changan_first-main/example и SeatHeat_v2 по
         34 permission, здесь 26 — подмножество, ничего лишнего.

         Намеренно убраны SYSTEM_ALERT_WINDOW и WRITE_SETTINGS: это единственные
         два разрешения набора, которые система требует включать руками на
         отдельном экране, а кодом они не используются нигде — ни здесь, ни во
         Flutter-версии, ни в плагине. Поверх окон мы не рисуем и Activity из
         фона не запускаем (ограничение появилось на Android 10, голова — 9),
         системные настройки не меняем. Убрав их, убираем и ручной шаг после
         установки. Если на голове что-то отвалится, вернуть — одна строка.

         Lint ругается на три оставшихся, и все три есть в обоих оригиналах.
         Правила писаны для публикации в Play Store; здесь sideload на AAOS,
         где envelope доказанно работает, а урезание грозит потерей цикла
         ручной прошивки. Поэтому подавляем адресно, а не удаляем:
           CoarseFineLocation   — FINE без COARSE, как в оригинале;
           ProtectedPermissions — system-only, обычному APK всё равно не
                                  выдаются, но присутствуют в оригинале. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.MOUNT_UNMOUNT_FILESYSTEMS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:ignore="CoarseFineLocation" />

    <uses-permission android:name="android.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="android.car.permission.CAR_POWER" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />
    <uses-permission android:name="android.car.permission.READ_CAR_STEERING" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.PERMISSION_READ_DISPLAY_UNITS" />
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <uses-permission android:name="android.car.permission.CAR_INSTRUMENT_CLUSTER_CONTROL" />
    <uses-permission android:name="android.car.permission.BIND_INSTRUMENT_CLUSTER_RENDERER_SERVICE" />

    <uses-permission android:name="coagent.permission.SEND_PROTOCOL" />

    <!-- Этап 2: foreground-сервис подогрева и его автозапуск после
         перезагрузки головы. Все четыре есть в оригинальном наборе. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Замер, а не рабочий путь: даёт ли голова whitelisted-пакету право
         включить службу доступности без похода в настройки. Обычному APK не
         выдаётся никогда (signature|privileged), но com.wt.airconditioner эта
         голова уже пускает к car API, так что проверить дешевле, чем гадать.
         Если на голове не выдалось — строку удалить вместе с enableWithoutUi. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:label="AutoHeat"
        android:icon="@android:drawable/ic_menu_compass"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".SeatHeatService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Оживление процесса после сна головы: BOOT_COMPLETED при пробуждении
             не приходит, а службу доступности система биндит сама. -->
        <service
            android:name=".HeatAccessibilityService"
            android:exported="true"
            android:label="AutoHeat"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- MTK-головы при быстром старте шлют vendor-действие вместо
                     BOOT_COMPLETED; фильтр ничего не стоит, см. BootReceiver. -->
                <action android:name="android.intent.action.ACTION_BOOT_IPO" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
